# Copiez ce fichier en `.env.local`. `.env.local` est ignore par git.

# URL de l'API FastAPI. En local : http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Formulaire de contact (page A propos). Cle publique Web3Forms.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Note sur l'authentification : le frontend ne detient aucun secret. Le jeton de
# session est emis par FastAPI, range dans un cookie httpOnly par les routes de
# `app/api/auth/`, et verifie par le backend a chaque appel. Rien a configurer
# ici.
